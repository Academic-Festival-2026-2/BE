# 이 파일을 복사해 .env로 이름을 바꾸고 값을 채우세요. (.env는 git에 올라가지 않음)
# .env가 없으면 application.yml 기본값(로컬 MySQL root/password, 로컬용 JWT 키)으로 실행됩니다.
# 값을 비워 둘 항목은 줄을 지우세요. 빈 값(KEY=)은 기본값 대신 빈 문자열로 들어갑니다.
JWT_SECRET=
DB_URL=jdbc:mysql://localhost:3306/binteum?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=password
SERVER_PORT=8080
