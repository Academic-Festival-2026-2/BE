# .env가 없으면 application.yml 기본값(로컬 MySQL root/password, 로컬용 JWT 키)으로 실행됩니다.
# 빈 값(KEY=)은 기본값 대신 빈 문자열로 들어가니, 쓰지 않는 항목은 주석(#)으로 두세요.
# IntelliJ: 실행 구성 → 환경 변수 → 폴더 아이콘으로 이 .env 파일을 연결해야 적용됩니다.

# JWT_SECRET=
DB_URL=jdbc:mysql://localhost:3306/pixel?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=password
SERVER_PORT=8080

# 사진 업로드(S3). 키는 받은 본인 키를 넣고 주석을 푸세요.
# 키는 Git, 단체방, 캡처로 공유하지 마세요.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=pixel-cs24-dev

# 사진 AI 검수(Claude). 기본은 꺼짐(모든 사진 PUBLIC). 켜려면 두 줄 주석을 풀고 키를 넣으세요.
# 키는 Git, 단체방, 캡처로 공유하지 마세요.
# MODERATION_ENABLED=true
# ANTHROPIC_API_KEY=
